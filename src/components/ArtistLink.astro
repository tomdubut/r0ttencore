---
/*
 * An artist name in a line-up:
 *   - page switched on in Sanity ("Show artist page") → link to /artists/<slug>/  (↘)
 *   - otherwise, Instagram handle → link to Instagram, new tab                    (↗)
 *   - otherwise → plain name
 */
import type { Artist } from '../lib/types';
import { instagramUrl } from '../lib/format';
import { paths } from '../lib/paths';

interface Props {
  artist: Artist;
}
const { artist } = Astro.props;
---

{
  artist.showPage ? (
    <a href={paths.artist(artist.slug)}>{artist.name} ↘</a>
  ) : artist.instagram ? (
    <a href={instagramUrl(artist.instagram)} target="_blank" rel="noopener">
      {artist.name} ↗<span class="sr-only"> on Instagram (opens in a new tab)</span>
    </a>
  ) : (
    <span>{artist.name}</span>
  )
}

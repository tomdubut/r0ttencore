---
/*
 * Click-to-play YouTube embed ("facade"): shows a poster + play button.
 * The YouTube iframe (youtube-nocookie.com) is only created when the visitor clicks,
 * so no YouTube scripts load with the page. Without JS, the button is a plain link to YouTube.
 */
import Grain from './Grain.astro';
import PlayButton from './PlayButton.astro';
import type { ImageAsset } from '../lib/types';
import { youtubeId } from '../lib/format';

interface Props {
  url: string;
  title: string;
  poster?: ImageAsset;
}

const { url, title, poster } = Astro.props;
const id = youtubeId(url);
const posterUrl = poster?.url ?? (id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : undefined);
---

<a class="yt" href={url} data-yt-id={id} data-yt-title={title} target="_blank" rel="noopener">
  {posterUrl && <img src={posterUrl} alt="" loading="lazy" decoding="async" />}
  <Grain opacity={0.3} />
  <PlayButton />
  <span class="sr-only">Play video: {title}</span>
</a>

<script>
  import '../scripts/youtube-facade';
</script>

<style>
  .yt {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--bg-light);
    cursor: pointer;
  }

  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt:hover :global(.play),
  .yt:focus-visible :global(.play) {
    background: var(--bg-light);
    color: var(--ink);
  }

  .yt:focus-visible {
    outline-offset: -4px;
  }

  :global(.yt-frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

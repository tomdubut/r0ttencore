---
/*
 * Film-grain overlay (SVG feTurbulence, as in the mockups). Decorative.
 * The filter itself (#grain) is defined once in BaseLayout.
 */
interface Props {
  opacity?: number;
}
const { opacity = 0.45 } = Astro.props;
---

<svg class="grain" style={`opacity: ${opacity}`} aria-hidden="true" focusable="false">
  <rect width="100%" height="100%" filter="url(#grain)"></rect>
</svg>

<style>
  .grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: overlay;
    pointer-events: none;
  }
</style>

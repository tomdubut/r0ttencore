---
/*
 * Event page — mockup event-page-E2.html.
 * Past event: hero (info + media) → photos → videos → the night + credits → more events.
 * Upcoming event: hero with TICKETS; photos / videos / credits are hidden.
 * Any section without content is hidden, on any event.
 */
import { paths } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Media from '../../components/Media.astro';
import Pill from '../../components/Pill.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import EventCard from '../../components/EventCard.astro';
import Slideshow from '../../components/Slideshow.astro';
import ArtistLink from '../../components/ArtistLink.astro';
import { getEvents, getSettings, isEventUpcoming } from '../../lib/content';
import { alternate, creditLine, creditsFor, formatDate, instagramUrl, videoMedia } from '../../lib/format';
import { CREDIT_ROLES, type EventDoc } from '../../lib/types';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: EventDoc;
}

const { event } = Astro.props;
const upcoming = isEventUpcoming(event);
const all = await getEvents();
const { texts } = await getSettings();

const photos = upcoming ? [] : event.gallery;
const [mainVideo, ...clips] = upcoming ? [] : event.videos;
// Credits grouped by role (several people per role possible). Location falls back to the venue.
const creditRows = CREDIT_ROLES.map((role) => {
  const people = creditsFor(event, role);
  return { role, people: people.length || role !== 'Location' ? people : [{ role, name: event.venue }] };
}).filter((row) => row.people.length > 0);
const showCredits = !upcoming && event.credits.length > 0;
const photoCredit = creditLine(event, 'Photos');
const videoCredit = creditLine(event, 'Video');
const showNight = Boolean(event.text) || showCredits;

// More events: the upcoming one first (if it isn't this one), then the most recent others. Max 2.
const others = all.filter((e) => e.slug !== event.slug);
const more = [...others.filter(isEventUpcoming), ...others.filter((e) => !isEventUpcoming(e))].slice(0, 2);

// Sections after the hero alternate dark / light, whichever are present.
const present = [
  photos.length > 0 && 'photos',
  mainVideo && 'videos',
  showNight && 'night',
  more.length > 0 && 'more',
].filter(Boolean) as string[];
const themes = alternate('dark', present.length);
const themeOf = (key: string) => themes[present.indexOf(key)];

const city = event.city.toUpperCase();
---

<BaseLayout title={`${event.title} — ${event.city}`} description={event.text || texts.eventsDescription}>
  <Header slot="header" active="events" split />

  <!-- 1. Hero: info panel (light) + media panel (black) -->
  <section class="hero" aria-labelledby="event-title">
    <div class="hero-info theme-light">
      <img class="hero-texture" src="/textures/texture-grain-splash.webp" alt="" decoding="async" />
      <div class="hero-info-inner">
        <a class="mono back" href={paths.events}>← ALL EVENTS</a>
        <p class="display number" aria-hidden="true">{event.number}</p>
        <h1 id="event-title" class="display name">
          <span class="sr-only">Event {event.number}: </span>{event.title}
        </h1>
        <p class="meta">
          <span>{city}</span>
          <span>{formatDate(event.date)}</span>
          <span>{event.venue}</span>
        </p>

        {
          upcoming && (
            <div class="tickets">
              {event.ticketUrl ? (
                <Pill href={event.ticketUrl} variant="filled" size="l" external>
                  TICKETS ↗
                </Pill>
              ) : (
                <Pill variant="filled" size="l">
                  {texts.ticketsSoon}
                </Pill>
              )}
            </div>
          )
        }

        {
          event.lineup.length > 0 && (
            <div class="lineup">
              <h2 class="mono lineup-label">LINE-UP</h2>
              <ul>
                {event.lineup.map((artist) => (
                  <li>
                    <ArtistLink artist={artist} />
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    <div class="hero-media theme-black">
      <Media
        media={event.heroMedia}
        label="[HERO IMAGE / VIDEO]"
        seed={Number(event.number)}
        class="hero-media-slot"
        eager
        sizes="(min-width: 900px) 50vw, 100vw"
      />
    </div>
  </section>

  <!-- 2. Photos -->
  {
    photos.length > 0 && (
      <Slideshow
        id="photos"
        title="PHOTOS"
        theme={themeOf('photos')}
        items={photos.map((p) => (p.image ? { kind: 'image', image: p.image, alt: p.alt } : null))}
        credit={photoCredit ? `PHOTOS — ${photoCredit}` : undefined}
      />
    )
  }

  <!-- 3. Videos: main aftermovie + clips -->
  {
    mainVideo && (
      <section class:list={['section', `theme-${themeOf('videos')}`]} aria-labelledby="videos-title">
        <div class="wrap">
          <SectionTitle
            id="videos-title"
            title="VIDEOS"
            size="title-s"
            rule="thick"
            meta={videoCredit ? `VIDEO — ${videoCredit}` : undefined}
          />
          <div class="videos">
            <Media
              media={videoMedia(mainVideo)}
              label={`${mainVideo.title} — 16:9`}
              labelPosition="bottom"
              play
              seed={5}
              class="video-main"
              ratio="16 / 9"
              sizes="(min-width: 900px) 66vw, 100vw"
            />
            {clips.length > 0 && (
              <ul class="clips">
                {clips.map((clip) => (
                  <li>
                    {clip.url ? (
                      <a class="clip" href={clip.url} target="_blank" rel="noopener">
                        <span class="display">▶ {clip.title}</span>
                        <span class="sr-only"> (YouTube, opens in a new tab)</span>
                      </a>
                    ) : (
                      <span class="clip">
                        <span class="display">▶ {clip.title}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- 4. The night + credits -->
  {
    showNight && (
      <section class:list={['section', `theme-${themeOf('night')}`]} aria-label="About the night">
        <div class="wrap night">
          {event.text && (
            <div class="night-text">
              <p class="mono muted">{texts.nightLabel}</p>
              <p class="night-body">{event.text}</p>
            </div>
          )}
          {showCredits && (
            <div class="credits mono">
              <h2 class="credits-head muted">CREDITS</h2>
              <dl>
                {creditRows.map(({ role, people }) => (
                  <div class="credit">
                    <dt>{role.toUpperCase()}</dt>
                    <dd>
                      {people.map((person, i) => (
                        <>
                          {i > 0 && <span aria-hidden="true"> · </span>}
                          {person.instagram ? (
                            <a href={instagramUrl(person.instagram)} target="_blank" rel="noopener">
                              {person.name} ↗<span class="sr-only"> on Instagram (opens in a new tab)</span>
                            </a>
                          ) : (
                            <span>{person.name}</span>
                          )}
                        </>
                      ))}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- 5. More events -->
  {
    more.length > 0 && (
      <section class:list={['section', `theme-${themeOf('more')}`]} aria-labelledby="more-title">
        <div class="wrap">
          <h2 id="more-title" class="display more-title">MORE EVENTS</h2>
          <div class="more-grid">
            {more.map((e) => (
              <EventCard event={e} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
  }

  .hero-info {
    position: relative;
    overflow: hidden;
  }

  .hero-texture {
    position: absolute;
    left: -120px;
    bottom: -80px;
    width: min(640px, 140vw);
    max-width: none;
    opacity: 0.35;
    pointer-events: none;
  }

  .hero-info-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px var(--gutter) clamp(40px, 3.3vw, 48px);
  }

  .back {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    letter-spacing: 0;
  }

  .back:hover {
    opacity: 0.65;
  }

  /* Decorative: let clicks pass through (its text box overlaps the back link above). */
  .number {
    pointer-events: none;
    font-size: var(--fs-mega);
    line-height: 0.8;
    margin-top: 16px;
  }

  .name {
    font-size: var(--fs-display-l);
    line-height: 0.92;
    margin-top: 20px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    margin-top: 20px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--ink);
    font-family: var(--font-heavy);
    font-size: clamp(15px, 1.2vw, 17px);
  }

  .tickets {
    margin-top: 24px;
  }

  .lineup {
    margin-top: 24px;
  }

  .lineup-label {
    font-weight: 400;
    font-size: 12px;
    margin-bottom: 8px;
  }

  .lineup ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-heavy);
    font-size: clamp(24px, calc(24px + 10 * (100vw - 390px) / 1050), 34px);
    line-height: 1.12;
  }

  .lineup a:hover {
    opacity: 0.65;
  }

  /* The media fills its whole panel (cropped to fit): a full-width square on phones,
     the entire right half on desktop. */
  .hero-media {
    position: relative;
    aspect-ratio: 1 / 1;
  }

  .hero-media :global(.hero-media-slot) {
    position: absolute;
    inset: 0;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: calc(min(100svh, 960px) - var(--header-h));
    }

    .hero-info-inner {
      padding-top: 28px;
    }

    .hero-media {
      aspect-ratio: auto;
    }
  }

  /* ---------- Videos ---------- */
  .videos {
    display: grid;
    gap: 24px;
    margin-top: 32px;
  }

  .clips {
    border-top: 2px solid var(--fg);
  }

  .clip {
    display: flex;
    align-items: center;
    min-height: clamp(72px, 7vw, 100px);
    border-bottom: 1px solid var(--fg);
    font-size: var(--fs-display-s);
  }

  a.clip:hover {
    opacity: 0.65;
  }

  @media (min-width: 900px) {
    .videos {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }

    .videos :global(.video-main) {
      grid-column: span 8;
    }

    .clips {
      grid-column: span 4;
    }
  }

  /* ---------- The night + credits ---------- */
  .night {
    display: grid;
    gap: 48px;
  }

  .night-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .night-body {
    font-weight: 800;
    font-size: clamp(22px, calc(22px + 8 * (100vw - 390px) / 1050), 30px);
    line-height: 1.28;
    letter-spacing: -0.6px;
  }

  .credits {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    font-size: 14px;
    letter-spacing: 0;
  }

  .credits dl {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }

  .credits-head {
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 1px;
  }

  .credit {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-footer);
  }

  .theme-light .credit {
    border-color: var(--ink);
  }

  .credit dd {
    margin: 0;
    text-align: right;
  }

  .credit dd a:hover {
    opacity: 0.65;
  }

  /* Phone: long lists of names go under the role. */
  @media (max-width: 599px) {
    .credit {
      flex-direction: column;
      gap: 4px;
    }

    .credit dd {
      text-align: left;
    }
  }

  @media (min-width: 900px) {
    .night {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }

    .night-text {
      grid-column: span 6;
    }

    .credits {
      grid-column: 8 / span 5;
    }
  }

  /* ---------- More events ---------- */
  .more-title {
    font-size: clamp(64px, calc(64px + 56 * (100vw - 390px) / 1050), 120px);
    line-height: 0.9;
  }

  .more-grid {
    display: grid;
    gap: 16px;
    margin-top: clamp(24px, 2.8vw, 40px);
  }

  @media (min-width: 768px) {
    .more-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

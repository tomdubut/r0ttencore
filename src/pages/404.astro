---
/* Not found page. Served by Cloudflare for unknown URLs (wrangler.jsonc: not_found_handling). */
import { paths } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Pill from '../components/Pill.astro';
import { getSettings } from '../lib/content';
import Arrow from '../components/icons/Arrow.astro';

const { texts } = await getSettings();
---

<BaseLayout title="Page not found" description={texts.notFoundText} noindex>
  <Header slot="header" />
  <section class="section nf theme-dark" aria-labelledby="nf-title">
    <div class="wrap nf-inner">
      <h1 id="nf-title" class="display nf-title">404</h1>
      <p class="lead">{texts.notFoundText}</p>
      <Pill href={paths.events} size="l">EVENTS<Arrow inline /></Pill>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    min-height: 50svh;
  }

  .nf-title {
    font-size: var(--fs-mega);
    line-height: 0.82;
  }
</style>
